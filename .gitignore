.venv/
.cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
!.env.example

# Web build and local Worker state.
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
web/.wrangler/
web/.dev.vars*
!web/.dev.vars.example

# The book text and all derived passages must remain local.
data/raw/
data/epub/
data/txt/
data/indexes/

# Model downloads and generated benchmark reports are local artifacts.
models/
evaluation/reports/

# The production runtime contains private corpus-derived artifacts.
deploy/runtime/*
!deploy/runtime/README.md
!deploy/runtime/index/
deploy/runtime/index/*
!deploy/runtime/index/.gitkeep
!deploy/runtime/models/
deploy/runtime/models/*
!deploy/runtime/models/.gitkeep
