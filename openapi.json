{
  "components": {
    "schemas": {
      "BookResultCountResponse": {
        "properties": {
          "book_id": {
            "title": "Book Id",
            "type": "string"
          },
          "book_title": {
            "title": "Book Title",
            "type": "string"
          },
          "result_count": {
            "title": "Result Count",
            "type": "integer"
          }
        },
        "required": [
          "book_id",
          "book_title",
          "result_count"
        ],
        "title": "BookResultCountResponse",
        "type": "object"
      },
      "CatalogBookResponse": {
        "properties": {
          "book_id": {
            "title": "Book Id",
            "type": "string"
          },
          "book_sequence": {
            "title": "Book Sequence",
            "type": "integer"
          },
          "book_title": {
            "title": "Book Title",
            "type": "string"
          },
          "povs": {
            "items": {
              "type": "string"
            },
            "title": "Povs",
            "type": "array"
          }
        },
        "required": [
          "book_id",
          "book_title",
          "book_sequence",
          "povs"
        ],
        "title": "CatalogBookResponse",
        "type": "object"
      },
      "ChunkMetadata": {
        "properties": {
          "book_id": {
            "title": "Book Id",
            "type": "string"
          },
          "book_sequence": {
            "title": "Book Sequence",
            "type": "integer"
          },
          "book_title": {
            "title": "Book Title",
            "type": "string"
          },
          "chapter_id": {
            "title": "Chapter Id",
            "type": "string"
          },
          "chapter_sequence": {
            "title": "Chapter Sequence",
            "type": "integer"
          },
          "chapter_title": {
            "title": "Chapter Title",
            "type": "string"
          },
          "chunk_ordinal": {
            "title": "Chunk Ordinal",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "pov": {
            "title": "Pov",
            "type": "string"
          },
          "pov_ordinal": {
            "title": "Pov Ordinal",
            "type": "integer"
          },
          "word_end": {
            "title": "Word End",
            "type": "integer"
          },
          "word_start": {
            "title": "Word Start",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "chapter_id",
          "chapter_title",
          "chapter_sequence",
          "pov",
          "pov_ordinal",
          "chunk_ordinal",
          "word_start",
          "word_end",
          "book_id",
          "book_title",
          "book_sequence"
        ],
        "title": "ChunkMetadata",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "index_configured": {
            "title": "Index Configured",
            "type": "boolean"
          },
          "model_loaded": {
            "title": "Model Loaded",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "model_loaded",
          "index_configured"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PassageFragmentResponse": {
        "properties": {
          "region": {
            "enum": [
              "before",
              "focus",
              "after"
            ],
            "title": "Region",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "region",
          "text"
        ],
        "title": "PassageFragmentResponse",
        "type": "object"
      },
      "PassageParagraphResponse": {
        "properties": {
          "fragments": {
            "items": {
              "$ref": "#/components/schemas/PassageFragmentResponse"
            },
            "title": "Fragments",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "ordinal": {
            "title": "Ordinal",
            "type": "integer"
          },
          "partial_end": {
            "title": "Partial End",
            "type": "boolean"
          },
          "partial_start": {
            "title": "Partial Start",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "ordinal",
          "partial_start",
          "partial_end",
          "fragments"
        ],
        "title": "PassageParagraphResponse",
        "type": "object"
      },
      "SearchCatalogResponse": {
        "properties": {
          "books": {
            "items": {
              "$ref": "#/components/schemas/CatalogBookResponse"
            },
            "title": "Books",
            "type": "array"
          }
        },
        "required": [
          "books"
        ],
        "title": "SearchCatalogResponse",
        "type": "object"
      },
      "SearchPaginationResponse": {
        "properties": {
          "has_next": {
            "title": "Has Next",
            "type": "boolean"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "total_pages": {
            "title": "Total Pages",
            "type": "integer"
          },
          "total_results": {
            "title": "Total Results",
            "type": "integer"
          }
        },
        "required": [
          "page",
          "page_size",
          "total_results",
          "total_pages",
          "has_next"
        ],
        "title": "SearchPaginationResponse",
        "type": "object"
      },
      "SearchRequest": {
        "properties": {
          "book": {
            "anyOf": [
              {
                "maxLength": 16,
                "pattern": "^[a-zA-Z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Book"
          },
          "mode": {
            "default": "hybrid",
            "enum": [
              "hybrid",
              "lexical"
            ],
            "title": "Mode",
            "type": "string"
          },
          "page": {
            "anyOf": [
              {
                "maximum": 1000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "page_size": {
            "anyOf": [
              {
                "maximum": 50.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Size"
          },
          "pov": {
            "anyOf": [
              {
                "maxLength": 32,
                "pattern": "^[a-zA-Z -]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pov"
          },
          "povs": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 32,
                  "pattern": "^[a-zA-Z -]+$",
                  "type": "string"
                },
                "maxItems": 50,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Povs"
          },
          "query": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "top": {
            "anyOf": [
              {
                "maximum": 10.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "book_counts": {
            "items": {
              "$ref": "#/components/schemas/BookResultCountResponse"
            },
            "title": "Book Counts",
            "type": "array"
          },
          "cached": {
            "title": "Cached",
            "type": "boolean"
          },
          "duration_ms": {
            "title": "Duration Ms",
            "type": "number"
          },
          "pagination": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SearchPaginationResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "result_count": {
            "title": "Result Count",
            "type": "integer"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResultResponse"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "query",
          "result_count",
          "duration_ms",
          "cached",
          "results"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "SearchResultResponse": {
        "properties": {
          "chunk": {
            "$ref": "#/components/schemas/ChunkMetadata"
          },
          "context_after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context After"
          },
          "context_before": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Before"
          },
          "context_word_end": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Word End"
          },
          "context_word_start": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Word Start"
          },
          "excerpt": {
            "title": "Excerpt",
            "type": "string"
          },
          "paragraphs": {
            "items": {
              "$ref": "#/components/schemas/PassageParagraphResponse"
            },
            "title": "Paragraphs",
            "type": "array"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "retrieval": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieval"
          },
          "score": {
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "rank",
          "score",
          "chunk",
          "excerpt"
        ],
        "title": "SearchResultResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Passage search over a privately supplied narrative corpus.",
    "title": "Weirwood Index API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "operations"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "readiness_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness",
        "tags": [
          "operations"
        ]
      }
    },
    "/v1/catalog": {
      "get": {
        "operationId": "catalog_v1_catalog_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchCatalogResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Catalog",
        "tags": [
          "search"
        ]
      }
    },
    "/v1/search": {
      "post": {
        "operationId": "search_v1_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search",
        "tags": [
          "search"
        ]
      }
    }
  }
}
